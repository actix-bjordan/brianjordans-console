# Copy to .env for local development with docker compose.
# The real values in AWS live in SSM Parameter Store, not here.

# From the Google Cloud console OAuth 2.0 Client ID (type: Web application).
# For local use, add http://localhost:8080/auth/callback as an authorized
# redirect URI on the same client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Any long random string. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Seeded as an active admin when the directory has no admin yet.
BOOTSTRAP_ADMIN_EMAIL=contact@brianjordans.com
